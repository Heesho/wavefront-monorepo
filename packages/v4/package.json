{
  "name": "@wavefront/v4",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Wavefront on Uniswap v4: bonding curve, floor ratchet and borrowing as a v4 hook",
  "scripts": {
    "build": "forge build",
    "build:reference": "forge build --root ../foundry",
    "test": "yarn build:reference && forge test",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "lint": "solhint 'src/**/*.sol'",
    "coverage": "yarn build:reference && forge coverage",
    "test:fork": "BASE_RPC_URL=${BASE_RPC_URL:-https://mainnet.base.org} forge test --match-contract BaseForkTest"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-periphery": "1.0.3",
    "solmate": "6.8.0"
  },
  "devDependencies": {
    "solhint": "6.2.5"
  }
}
